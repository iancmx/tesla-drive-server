# Copy to .env and adjust. All values are optional.

# Port to listen on (default 8742)
PORT=8742

# Interface to bind. Keep 127.0.0.1 for local-only use (put a reverse
# proxy in front for HTTPS/WSS); set 0.0.0.0 only if you understand
# that anyone on the network can then use this server.
HOST=127.0.0.1

# yt-dlp binary name/path (default: yt-dlp from PATH)
YT_DLP=yt-dlp

# Optional: path to a yt-dlp cookies file (Netscape format, exported
# from a logged-in browser). Passed to yt-dlp as --cookies.
# Needed when YouTube bot-blocks your server's IP
# ("Sign in to confirm you're not a bot"). Keep this file private.
YT_DLP_COOKIES=
